# Knock settings for in-app Notifications.
# The server reads these from the process environment. Nothing auto-loads
# .env: export them in your shell (or your host's settings) before starting.
# Leave KNOCK_API_KEY blank until you have a real key: once set, every
# Notification goes to Knock, and a bogus key makes each one fail (see #12).
# Blank, Notifications are written to .outbox/notifications/ instead.

# Secret API key; server-side workflow triggers. Blank = write to the outbox.
KNOCK_API_KEY=
# Public API key; the browser uses it for the bell. Blank = bell shows an empty feed.
KNOCK_PUBLIC_API_KEY=
# Channel id of the in-app feed channel (cadence-in-app) the bell reads.
KNOCK_FEED_CHANNEL_ID=
# Private signing key (PEM) used to sign user tokens for enhanced security mode.
KNOCK_SIGNING_KEY=
# Service token for the Knock CLI (pushing .knock/ workflows); not read by the app.
KNOCK_SERVICE_TOKEN=
